{
  "expo": {
    "name": "今日もだるい",
    "slug": "kyodaru",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nkdevtech.kyodaru",
      "infoPlist": {
        "CFBundleDisplayName": "今日だる",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nkdevtech.kyodaru",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4FA3C7",
          "image": "./assets/images/mascot.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/mascot.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の気圧・天気を自動取得し、体調の記録と分析に役立てるために位置情報を使用します"
        }
      ],
      [
        "./plugins/withAndroidAppLabel",
        {
          "label": "今日だる"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "156b0791-69fb-4ee3-920e-d4d6a166e9b2"
      }
    },
    "owner": "nkdev-tech"
  }
}
